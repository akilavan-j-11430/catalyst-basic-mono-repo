# Never staged for Slate: deployed values are set in Console -> Slate -> web -> Environment
# Variables.

# Read by the server at request time.
# Where Catalyst sends a new user from the confirmation email.
AUTH_REDIRECT_URL=
# Timezone for log timestamps, e.g. Asia/Kolkata. Optional.
TZ=

# Read at build time, and only in the deployed build.

# The AppSail origin the browser calls, e.g. https://api-<ZAID>.development.catalystappsail.com
# Set it in Console -> Slate -> web -> Environment Variables. Leave it unset locally, so
# calls stay relative and go through apps/proxy.
NEXT_PUBLIC_API_URL=
