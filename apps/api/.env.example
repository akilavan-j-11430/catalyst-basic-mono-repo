# Read by apps/api. Every key is declared on its template in src/env.ts.
# Copy to apps/api/.env - gitignored - and fill in the values.

# Where Catalyst sends a new user from the confirmation email. Locally this is the
# origin `catalyst serve` prints, usually http://localhost:3001/
AUTH_REDIRECT_URL=

# Optional. Timezone for log timestamps. Defaults to Asia/Kolkata.
TZ=
